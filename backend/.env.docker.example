# Environment for `docker run --env-file`. Copy to .env.docker (git-ignored) and adjust:
#   cp backend/.env.docker.example backend/.env.docker
# No real secrets here. Every value is optional; the image's defaults are shown. Don't put
# KEY="value" quotes or inline comments on a line: --env-file passes them through literally.

# ---- required only for the AI image with AI chat (LL_ORCHESTRATOR below)
# Messages and document passages are sent to Anthropic's API when this is used.
ANTHROPIC_API_KEY=replace-me

# ---- server (set by the image; change LL_PORT only together with the -p mapping)
LL_HOST=0.0.0.0
LL_PORT=8000
LL_ALLOW_REMOTE=true
# JSON list of browser origins allowed to call the API directly (not needed behind a proxy)
LL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- storage: mount a volume here (SQLite DB, uploads, AI index, downloaded models)
LL_DATA_DIR=/data

# ---- logging: JSON lines on stdout
LL_LOG_LEVEL=INFO
LL_LOG_JSON=true

# ---- limits
LL_MAX_UPLOAD_MB=25
LL_MAX_PAGES=300
LL_MAX_DOCUMENTS=100
LL_MAX_MESSAGE_CHARS=8000
LL_HISTORY_TURNS=10

# ---- ingestion jobs
LL_INGESTION_TIMEOUT_S=1800
LL_INGESTION_MAX_RETRIES=2
LL_INGESTION_RETRY_BACKOFF_S=1.0

# ---- chat stream
LL_STREAM_FIRST_EVENT_TIMEOUT_S=45
LL_STREAM_TOTAL_TIMEOUT_S=600
LL_SSE_PING_INTERVAL_S=15

# ---- adapters: "standin" (no AI) works in every image. The AI image (LL_EXTRAS=ai) also takes:
#   LL_ORCHESTRATOR=legallens.adapters.ai:create_orchestrator
#   LL_INGESTION=legallens.adapters.ai:create_ingestion
LL_ORCHESTRATOR=standin
LL_INGESTION=standin

# ---- AI layer (AI image only; full list in ai/.env.example)
# Models download here on first use (~3.6 GB). The with-models image sets /opt/models itself.
# LL_AI_MODELS_DIR=/data/models
# LL_AI_OCR_MODEL_SIZE=tiny
