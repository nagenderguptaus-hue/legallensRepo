# Copy to .env and adjust. Every setting is optional; the values below are the defaults.
# Environment variables (LL_*) override .env.

# ---- server
LL_HOST=127.0.0.1
LL_PORT=8000
# Only for containers whose port is published on the host's 127.0.0.1 (see compose.yaml).
LL_ALLOW_REMOTE=false
# JSON list of frontend origins allowed to call the API.
LL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- storage: uploaded files and the SQLite database live here (relative to the cwd)
LL_DATA_DIR=data

# ---- logging (JSON for machines, false = readable console output)
LL_LOG_LEVEL=INFO
LL_LOG_JSON=true

# ---- limits (BRD NFR-3)
LL_MAX_UPLOAD_MB=25
LL_MAX_PAGES=300
LL_MAX_DOCUMENTS=100
LL_MAX_MESSAGE_CHARS=8000
LL_HISTORY_TURNS=10

# ---- ingestion
LL_INGESTION_TIMEOUT_S=1800
LL_INGESTION_MAX_RETRIES=2
LL_INGESTION_RETRY_BACKOFF_S=1.0

# ---- chat stream
LL_STREAM_FIRST_EVENT_TIMEOUT_S=45
LL_STREAM_TOTAL_TIMEOUT_S=600
LL_SSE_PING_INTERVAL_S=15

# ---- AI layer adapters: "standin" (built-in, no AI) or "package.module:factory"
# Full AI (run `uv sync --extra ai` first):
#   LL_ORCHESTRATOR=legallens.adapters.ai:create_orchestrator   chat: Claude router → Ask /
#                                                                Summary / Draft / Clarify
#   LL_INGESTION=legallens.adapters.ai:create_ingestion          OCR, chunking, embeddings, index
#   ANTHROPIC_API_KEY=...                                        here, in the environment or in
#                                                                ai/.env
# AI chat needs AI ingestion (it answers from the AI index). AI ingestion also works alone
# (with the stand-in chat). Settings are LL_AI_* (ai/.env.example); the index lives in
# <LL_DATA_DIR>/ai. With AI chat on, messages and document passages are sent to Anthropic's API.
LL_ORCHESTRATOR=standin
LL_INGESTION=standin

# ---- stand-in simulations (demos and tests)
LL_STANDIN_MODEL_OFFLINE=false
LL_STANDIN_TOKEN_DELAY_MS=20
LL_STANDIN_FAIL_MIDSTREAM=false
