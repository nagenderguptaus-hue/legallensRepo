   "text": "GET    /api/conversations       list\nPOST   /api/conversations       new chat\nGET    /api/conversations/{id}  open\nPATCH  /api/conversations/{id}  rename\nDELETE /api/conversations/{id}  delete\n\nopen → messages + citations",
   "originalText": "GET    /api/conversations       list\nPOST   /api/conversations       new chat\nGET    /api/conversations/{id}  open\nPATCH  /api/conversations/{id}  rename\nDELETE /api/conversations/{id}  delete\n\nopen → messages + citations",
