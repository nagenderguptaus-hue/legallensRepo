# Copy to .env (never committed) and fill in.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).

# Intent router
# LL_AI_INTENT_MODEL=claude-haiku-4-5
# LL_AI_INTENT_TEMPERATURE=0
# LL_AI_INTENT_MAX_TOKENS=512
# LL_AI_INTENT_TIMEOUT_S=15
# LL_AI_INTENT_MAX_RETRIES=2
# LL_AI_INTENT_HISTORY_TURNS=6
# LL_AI_INTENT_TURN_CHARS=600

# Ask: query rewriter (pre-retrieval) and answer model
# LL_AI_REWRITE_MODEL=claude-haiku-4-5
# LL_AI_REWRITE_HISTORY_TURNS=6
# LL_AI_REWRITE_TURN_CHARS=600
# LL_AI_ASK_MODEL=claude-sonnet-5-5
# LL_AI_ASK_EFFORT=medium
# LL_AI_ASK_MAX_TOKENS=8000
# LL_AI_ASK_TIMEOUT_S=60

# Summary: Sonnet up to the threshold (estimated tokens), Opus above it
# LL_AI_SUMMARY_MODEL=claude-sonnet-5-5
# LL_AI_SUMMARY_LONG_MODEL=claude-opus-5-5
# LL_AI_SUMMARY_LONG_THRESHOLD_TOKENS=60000
# LL_AI_SUMMARY_EFFORT=medium
# LL_AI_SUMMARY_MAX_TOKENS=16000
# LL_AI_SUMMARY_TIMEOUT_S=300

# Draft
# LL_AI_DRAFT_MODEL=claude-opus-5-5
# LL_AI_DRAFT_EFFORT=high
# LL_AI_DRAFT_MAX_TOKENS=16000
# LL_AI_DRAFT_TIMEOUT_S=300

# Shared generation settings
# LL_AI_MAX_DOCUMENT_TOKENS=400000
# LL_AI_GENERATION_MAX_RETRIES=2
# LL_AI_REFUSAL_FALLBACKS=true

# Retrieval (all local)
# LL_AI_DATA_DIR=./data
# LL_AI_MODELS_DIR=./data/models
# LL_AI_QDRANT_URL=                 # unset = embedded Qdrant in <data_dir>/qdrant
# LL_AI_QDRANT_API_KEY=
# LL_AI_QDRANT_COLLECTION=legallens_chunks
# LL_AI_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5       # change = re-index
# LL_AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3        # GPU: Qwen/Qwen3-Reranker-0.6B (uv sync --group qwen)
# LL_AI_RETRIEVAL_VECTOR_K=25
# LL_AI_RETRIEVAL_KEYWORD_K=25
# LL_AI_RETRIEVAL_TOP_N=8
# LL_AI_RERANK_MIN_SCORE=          # unset = calibrated per reranker (retrieval/models.py)
# LL_AI_CHUNK_TARGET_WORDS=300
# LL_AI_CHUNK_MAX_WORDS=380

# Ingestion: loader for pages with a text layer, OCR for the rest (all local)
# LL_AI_OCR_ENGINE=rapidocr
# LL_AI_OCR_MODEL_SIZE=tiny          # tiny (fast, downloads once) | small (bundled, slower, best on bad scans)
# LL_AI_OCR_DPI=200                  # resolution scanned pages are rendered at
# LL_AI_OCR_MAX_SIDE=2000            # the engine shrinks larger page images to this
# LL_AI_OCR_ANGLE_CLS=false          # per-line 180° classifier; it flipped upright lines
# LL_AI_OCR_MIN_TEXT_CHARS=20        # fewer letters/digits in a page's text layer → OCR
# LL_AI_OCR_LOW_CONFIDENCE=0.955     # OCR'd pages below this get a warning (model-specific: ~0.98 for small)
